<Project>

  <!--
    Central package management (docs/12_BUILD.md). Every version is pinned here
    and nowhere else, which also makes Dependabot PRs single-file diffs.
    All versions verified against nuget.org on 2026-08-02; re-verified and bumped 2026-09-21; bumped again
    2026-10-25 (beta.29 PR-2) with the updates Dependabot had never proposed (docs/13_CI_CD.md §Dependabot and
    the NuGet audit), and 2026-10-26 (beta.30 PR-3): Velopack and Markdig, the SQLitePCLRaw pin dropped; and again
    2026-10-26 (beta.31, the owner's request): the .NET 10.0.14 servicing packages and the updates beta.30 had left.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <!--
      WPF UI (lepoco). Pinned EXACTLY, deliberately.
      The 4.x line has NuGet-deprecated releases with critical bugs
      (4.0.0-4.0.3, 4.1.0, 4.2.0). Never let this float, never go below 4.2.1,
      and read the release notes on every bump. docs/16_WPFUI_SYNTAX.md
      §Version hygiene. ui:NumberBox SpinButtonPlacementMode needs >= 4.3.0.
      Last reviewed: 2026-08-02.
    -->
    <PackageVersion Include="WPF-UI" Version="[4.3.0]" />
    <PackageVersion Include="WPF-UI.Abstractions" Version="[4.3.0]" />
    <PackageVersion Include="WPF-UI.DependencyInjection" Version="[4.3.0]" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <!--
      Markdig (Alexandre Mutel): Markdown rendered in the App (beta.12, owner request 4) - the Legal Gate, Help,
      About and the user guide show their documents rendered, not as raw text. BSD-2-Clause, no dependency on
      net10.0. The package ships no licence file, so its text is a reviewed override
      (tools/license-overrides/Markdig.txt). HTML is disabled in the pipeline (App/Markdown/MarkdownRenderer.cs).
    -->
    <PackageVersion Include="Markdig" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <!-- THE ALPHA BRANCH (D76): the three packages serviced with the runtime follow it (docs/12_BUILD.md §The alpha line). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Storage">
    <!-- No EF: Dapper over Microsoft.Data.Sqlite (CLAUDE.md pinned stack). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <!--
      No transitive pin on SQLitePCLRaw since beta.30 (2026-10-26). From the scaffold (2026-08-02) to beta.29 this held
      SQLitePCLRaw.bundle_e_sqlite3 at 3.0.5: Microsoft.Data.Sqlite 10.0.10 resolved SQLitePCLRaw.lib.e_sqlite3 2.1.11,
      which carries GHSA-2m69-gcr7-jv3q (vulnerable range <= 2.1.11) through its bundled SQLite, NU1903 under
      TreatWarningsAsErrors. Its own comment said to drop it once Microsoft.Data.Sqlite resolved a patched version on
      its own; 10.0.13 declares SQLitePCLRaw 2.1.13, and the pin had become a conflict NuGet does not report - it put a
      package built against the 2.x line on SQLitePCLRaw's 3.x line. The NuGet audit (Directory.Build.props) still
      turns a vulnerable SQLite red (docs/13_CI_CD.md §Dependabot and the NuGet audit).
      THE ALPHA BRANCH (D76): Microsoft.Data.Sqlite 11 declares SQLitePCLRaw 3.0.5 itself - the 3.x line, built for it this
      time, whose engine is SourceGear's SQLite package (SQLite 3.53.4); still no pin here.
    -->
  </ItemGroup>

  <ItemGroup Label="Interop, telemetry and packaging">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- MPL-2.0. docs/18_GPU_VENDOR_APIS.md §L2 requires >= 0.9.6, and
         legal/THIRD_PARTY_NOTICES.md has a release-gate check that no
         depended-upon file carries MPL-2.0 Exhibit B. Consume UNMODIFIED. -->
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- The crash witness (04_CAPTURE §Crash & exit classification): Application log events 1000/1001. In-box
         for WPF apps, a package for a class library on the Windows TFM. Microsoft, MIT. -->
    <PackageVersion Include="System.Diagnostics.EventLog" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (build-time only)">
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!--
      xUnit.net v3, 4.x line (2026-09-21). 4.0 made Microsoft Testing Platform v2 the default of the plain
      `xunit.v3` package and dropped MTP v1. build.ps1's gates are VSTest-shaped on purpose - the
      `XPlat Code Coverage` collector, `results.trx` read by the struct-mirror gate and by Invoke-TestsWithin -
      so the projects reference the SAME 4.x framework through its `mtp-off` variant, the one xunit publishes
      for exactly this. Moving to MTP v2 is a build.ps1 change, not a version bump; do them together or not at all.
    -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!--
      FluentAssertions is pinned to the 7.x line ON PURPOSE, and must not be
      bumped to 8.x without redoing the licence analysis.

      7.2.2  <license type="expression">Apache-2.0</license>
      8.0.0+ <license type="file">LICENSE.md</license>,
             "Copyright 2024-2025 Xceed Software Inc., all rights reserved"

      The 8.x line moved to Xceed's Community License, which is not an OSI
      licence and carries field-of-use restrictions. docs/18_GPU_VENDOR_APIS.md
      §Checklist before adding any vendor SDK is explicit: MIT / BSD /
      Apache-2.0 / MPL-2.0 proceed, anything else does not, and the decision
      gets recorded either way. That checklist is written about GPU SDKs but
      the reasoning does not stop at test dependencies.
      Reviewed 2026-08-02. See docs/20_OPEN_QUESTIONS.md §G.
    -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2]" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!--
      10.1.0 not taken on 2026-10-25: the tracker it injects into each instrumented assembly declares a constant,
      ModuleTrackerRegistryKey, whose value reflection cannot read ("Literal value was not found"), and
      NoSecondMatcherTests reads every string constant in Application, Domain and Infrastructure. Taken in beta.31
      (2026-10-26): that test now leaves out the types coverlet adds (namespace Coverlet.*), which are not ours.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

</Project>
