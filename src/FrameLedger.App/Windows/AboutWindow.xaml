<ui:FluentWindow x:Class="FrameLedger.App.Windows.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:FrameLedger.App"
                 xmlns:controls="clr-namespace:FrameLedger.App.Controls"
                 Title="{x:Static res:Strings.About_Title}"
                 Width="1000"
                 Height="760"
                 MinWidth="640"
                 MinHeight="440"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <!-- beta.12 (D45): the program's Appropriate Legal Notices (GPLv3 section 0), the third-party licences, the legal
         documents — tabs of one window, where About was a one-line message box. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.About_Title}" ShowMaximize="True" ShowMinimize="True" />
        <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,8,16,8">
            <TabItem Header="{x:Static res:Strings.About_Tab_App}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="{x:Static res:Strings.App_Title}" />
                        <ui:TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" />
                        <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static res:Strings.About_Tagline}" />
                        <ui:TextBlock Margin="0,20,0,6" FontTypography="Subtitle" Text="{x:Static res:Strings.About_Notices_Header}" />
                        <ui:TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.About_Notices_Copyright}" />
                        <ui:TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static res:Strings.About_Notices_Warranty}" />
                        <ui:TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static res:Strings.About_Notices_Licence}" />
                        <ui:TextBlock x:Name="SourceText" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,14,0,0">
                            <ui:Button Margin="0,0,8,8" Click="OnViewLicence" Content="{x:Static res:Strings.About_ViewLicence}" />
                            <ui:Button Margin="0,0,8,8" Click="OnViewNotice" Content="{x:Static res:Strings.About_ViewNotice}" />
                            <ui:Button Margin="0,0,8,8" Click="OnOpenSource" Content="{x:Static res:Strings.About_OpenSource}" Icon="{ui:SymbolIcon Open24}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static res:Strings.About_Tab_ThirdParty}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Click="OnOpenLicencesFolder" Content="{x:Static res:Strings.About_OpenLicencesFolder}" Icon="{ui:SymbolIcon Folder24}" />
                        <ui:TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Static res:Strings.About_ThirdParty_Body}" />
                    </DockPanel>
                    <ui:TextBlock x:Name="NoLicencesFolder" Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                  Text="{x:Static res:Strings.About_NoLicencesFolder}" Visibility="Collapsed" />
                    <controls:DocumentBrowser x:Name="ThirdParty" Grid.Row="2" />
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static res:Strings.About_Tab_Legal}">
                <controls:DocumentBrowser x:Name="Legal" Margin="0,12,0,0" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="16,0,16,16" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Appearance="Primary" Click="OnClose" Content="{x:Static res:Strings.Common_Close}" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
