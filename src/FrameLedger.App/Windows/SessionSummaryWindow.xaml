<ui:FluentWindow x:Class="FrameLedger.App.Windows.SessionSummaryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:windows="clr-namespace:FrameLedger.App.Windows"
                 xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
                 xmlns:controls="clr-namespace:FrameLedger.App.Controls"
                 xmlns:charts="clr-namespace:FrameLedger.App.Charts"
                 Title="{Binding ViewModel.Title}"
                 Width="1100"
                 Height="820"
                 MinWidth="760"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <!-- 08_UI §Session summary: a secondary FluentWindow. Stat cards from the stored aggregates, never recomputed. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding ViewModel.Title}" ShowMaximize="True" ShowMinimize="True" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageRoot}">
                <ui:TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{x:Static vm:SessionSummaryViewModel.NotFoundText}"
                              Visibility="{Binding ViewModel.NotFound, Converter={StaticResource BoolToVis}}" />

                <ui:InfoBar IsClosable="False" Severity="Error" Margin="0,0,0,12"
                            IsOpen="{Binding ViewModel.IsCrashed, Mode=OneWay}"
                            Title="{x:Static vm:SessionSummaryViewModel.CrashTitle}"
                            Message="{x:Static vm:SessionSummaryViewModel.CrashBody}" />
                <ui:InfoBar IsClosable="False" Severity="Warning" Margin="0,0,0,12"
                            IsOpen="{Binding ViewModel.IsUnhooked, Mode=OneWay}"
                            Title="{x:Static vm:SessionSummaryViewModel.UnhookedTitle}"
                            Message="{x:Static vm:SessionSummaryViewModel.UnhookedBody}" />

                <!-- header line + chips -->
                <ui:TextBlock Style="{StaticResource SecondaryText}" Text="{Binding ViewModel.Line}" />
                <ui:TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.ExitLine}" />
                <ui:TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.ExceptionLine}"
                              Visibility="{Binding ViewModel.ExceptionLine, Converter={StaticResource NullToCollapsed}}" />
                <!-- beta.10: how the game was shown, in either tier (03_METRICS §Display mode) -->
                <ui:TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.DisplayLine}"
                              Visibility="{Binding ViewModel.DisplayLine, Converter={StaticResource NullToCollapsed}}" />
                <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.HardwareLine}" />
                <!-- beta.24 (D64): the DLSS the session ran, each library with its version and where it was loaded from -->
                <ui:TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.DlssLine}"
                              Visibility="{Binding ViewModel.DlssLine, Converter={StaticResource NullToCollapsed}}" />
                <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.LibrariesLine}"
                              Visibility="{Binding ViewModel.LibrariesLine, Converter={StaticResource NullToCollapsed}}" />
                <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.DriverProfileLine}"
                              Visibility="{Binding ViewModel.DriverProfileLine, Converter={StaticResource NullToCollapsed}}" />
                <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.DriverStateLine}"
                              Visibility="{Binding ViewModel.DriverStateLine, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ViewModel.Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TriStateChipModel}">
                            <!-- FR-8.3: click → the override dialog -->
                            <Button Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding AccessibleName}"
                                    Command="{Binding ViewModel.OverrideCommand, RelativeSource={RelativeSource AncestorType={x:Type windows:SessionSummaryWindow}}}"
                                    CommandParameter="{Binding}">
                                <controls:TriStateChip Model="{Binding}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- stat cards -->
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ViewModel.Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatCardModel}">
                            <ui:Card Margin="0,0,8,8">
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" />
                                    <ui:TextBlock FontTypography="Subtitle" AutomationProperties.HeadingLevel="None" Text="{Binding Value}" />
                                    <ui:TextBlock Style="{StaticResource TertiaryText}" Text="{Binding Suffix}" Visibility="{Binding Suffix, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- beta.24 (D62): every frame-generation state the session held, each with its share of the presenting time and its
                     own Native to Displayed (CLAUDE.md rule 6): the stored fg_mix, never recomputed. The bar draws in the chart
                     palette's colours from code (FgMixBar); the table carries every number in text. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding ViewModel.HasFgMix, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.FgMixHeader}" />
                    <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.FgMixContext}"
                                  Visibility="{Binding ViewModel.FgMixContext, Converter={StaticResource NullToCollapsed}}" />
                    <controls:FgMixBar Margin="0,6,0,0" Height="14" Segments="{Binding ViewModel.FgMixSegments}"
                                       AutomationProperties.Name="{Binding ViewModel.FgMixName}" />
                    <StackPanel Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixSwatch" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixState" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixShare" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixRates" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MixTime" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="1" Margin="0,0,24,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.FgMixStateHeader}" />
                            <ui:TextBlock Grid.Column="2" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.FgMixShareHeader}" />
                            <ui:TextBlock Grid.Column="3" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.FgMixRatesHeader}" />
                            <ui:TextBlock Grid.Column="4" Margin="0,0,0,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.FgMixTimeHeader}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ViewModel.FgMix}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FgMixRowModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MixSwatch" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MixState" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MixShare" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MixRates" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MixTime" />
                                        </Grid.ColumnDefinitions>
                                        <controls:FgMixBar Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Segments="{Binding Swatch}" />
                                        <ui:TextBlock Grid.Column="1" Margin="0,2,24,2" Text="{Binding Label}" />
                                        <ui:TextBlock Grid.Column="2" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Share}" />
                                        <ui:TextBlock Grid.Column="3" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Rates}" />
                                        <ui:TextBlock Grid.Column="4" Margin="0,2,0,2" Style="{StaticResource SecondaryText}" TextAlignment="Right" Text="{Binding Duration}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.FgMixUnclassifiedNote}"
                                  Visibility="{Binding ViewModel.FgMixUnclassifiedNote, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.FgMixMissing}"
                              Visibility="{Binding ViewModel.FgMixMissing, Converter={StaticResource NullToCollapsed}}" />

                <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{x:Static vm:SessionSummaryViewModel.Tier2Text}"
                              Visibility="{Binding ViewModel.IsHooked, Converter={StaticResource InverseBoolToVis}}" />
                <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ViewModel.Tier2Reason}"
                              Visibility="{Binding ViewModel.IsHooked, Converter={StaticResource InverseBoolToVis}}" />

                <!-- charts -->
                <StackPanel Visibility="{Binding ViewModel.IsHooked, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.FrametimeHeader}" />
                        <CheckBox Grid.Column="1" Margin="0,0,16,0" Content="{x:Static vm:SessionSummaryViewModel.ShowDisplayedText}"
                                  IsChecked="{Binding ViewModel.ShowDisplayed}" IsEnabled="{Binding ViewModel.HasDisplayed}"
                                  Visibility="{Binding ViewModel.HasDisplayed, Converter={StaticResource BoolToVis}}" />
                        <!-- 0.1.0-beta.50: the controllers' connections, drops and low batteries as lines across the frames -->
                        <CheckBox Grid.Column="2" Margin="0,0,16,0" Content="{x:Static vm:SessionSummaryViewModel.ShowInputEventsText}"
                                  IsChecked="{Binding ViewModel.ShowInputEvents}"
                                  Visibility="{Binding ViewModel.HasInputEvents, Converter={StaticResource BoolToVis}}" />
                        <CheckBox Grid.Column="3" Content="{x:Static vm:SessionSummaryViewModel.ShowSensorsText}"
                                  IsChecked="{Binding ViewModel.ShowSensors}" IsEnabled="{Binding ViewModel.HasSensors}" />
                    </Grid>
                    <ui:TextBlock Style="{StaticResource TertiaryText}" Text="{Binding ViewModel.DecimationNote}" />
                    <charts:FrametimeChart x:Name="Frametime" Margin="0,6,0,0" Height="300" />
                    <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.DistributionHeader}" />
                    <charts:DistributionChart x:Name="Distribution" Margin="0,6,0,0" Height="260" />
                    <!-- beta.14 (D49): the render scale over the session -->
                    <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.RenderScaleHeader}" />
                    <charts:RenderScaleChart x:Name="RenderScale" Margin="0,6,0,0" Height="200" />
                </StackPanel>

                <!-- sensors, in either tier (beta.8): a session that was not hooked has nothing else to chart -->
                <StackPanel Visibility="{Binding ViewModel.HasSensorCharts, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.SensorsHeader}" />
                    <charts:SensorsChart x:Name="Sensors" Margin="0,6,0,0" />
                </StackPanel>

                <!-- beta.12: every series' STORED mean / median / minimum / peak (sensor_stats_json), never recomputed. An
                     ItemsControl over a shared-size grid rather than a DataGrid: a DataGrid's own scroller would take the
                     window's wheel. -->
                <StackPanel Visibility="{Binding ViewModel.HasSensorStats, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsHeader}" />
                    <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsNote}" />
                    <StackPanel Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatSeries" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatMean" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatMedian" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatMin" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatMax" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StatReadings" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Margin="0,0,24,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsSeriesHeader}" />
                            <ui:TextBlock Grid.Column="1" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsMeanHeader}" />
                            <ui:TextBlock Grid.Column="2" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsMedianHeader}" />
                            <ui:TextBlock Grid.Column="3" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsMinHeader}" />
                            <ui:TextBlock Grid.Column="4" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsMaxHeader}" />
                            <ui:TextBlock Grid.Column="5" Margin="0,0,0,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.SensorStatsReadingsHeader}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ViewModel.SensorStats}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SensorStatRowModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatSeries" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatMean" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatMedian" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatMin" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatMax" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StatReadings" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" Margin="0,2,24,2" Text="{Binding Series}" />
                                        <ui:TextBlock Grid.Column="1" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Mean}" />
                                        <ui:TextBlock Grid.Column="2" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Median}" />
                                        <ui:TextBlock Grid.Column="3" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Min}" />
                                        <ui:TextBlock Grid.Column="4" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Max}" />
                                        <ui:TextBlock Grid.Column="5" Margin="0,2,0,2" Style="{StaticResource SecondaryText}" TextAlignment="Right" Text="{Binding Readings}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.SensorStatsMissing}"
                              Visibility="{Binding ViewModel.SensorStatsMissing, Converter={StaticResource NullToCollapsed}}" />

                <!-- 0.1.0-beta.50 (D155-D163): what the session was played with, both tiers - read from outside the game. The bar
                     draws in the chart palette's colours from code (InputShareBar); the tables carry every number in text. -->
                <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.InputHeader}" />
                <ui:TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{x:Static vm:SessionSummaryViewModel.InputLimitsNote}" />
                <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputMissing}"
                              Visibility="{Binding ViewModel.InputMissing, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Visibility="{Binding ViewModel.HasInput, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputContext}"
                                  Visibility="{Binding ViewModel.InputContext, Converter={StaticResource NullToCollapsed}}" />
                    <controls:InputShareBar Margin="0,6,0,0" Height="14" Segments="{Binding ViewModel.InputSegments}"
                                            AutomationProperties.Name="{Binding ViewModel.InputName}" />
                    <StackPanel Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InputSwatch" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InputMethod" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InputShare" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="InputTime" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="1" Margin="0,0,24,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.InputMethodHeader}" />
                            <ui:TextBlock Grid.Column="2" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.FgMixShareHeader}" />
                            <ui:TextBlock Grid.Column="3" Margin="0,0,0,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.FgMixTimeHeader}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ViewModel.InputRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InputClassRowModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputSwatch" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputMethod" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputShare" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="InputTime" />
                                        </Grid.ColumnDefinitions>
                                        <controls:InputShareBar Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Segments="{Binding Swatch}" />
                                        <ui:TextBlock Grid.Column="1" Margin="0,2,24,2" Text="{Binding Label}" />
                                        <ui:TextBlock Grid.Column="2" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Share}" />
                                        <ui:TextBlock Grid.Column="3" Margin="0,2,0,2" Style="{StaticResource SecondaryText}" TextAlignment="Right" Text="{Binding Duration}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputSwitches}"
                                  Visibility="{Binding ViewModel.InputSwitches, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- the session's controllers: shown for any session that was read, in front or not -->
                <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputNoControllers}"
                              Visibility="{Binding ViewModel.InputNoControllers, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Visibility="{Binding ViewModel.HasInputControllers, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,12,0,0" FontTypography="BodyStrong" AutomationProperties.HeadingLevel="Level3" Text="{x:Static vm:SessionSummaryViewModel.InputControllersHeader}" />
                    <StackPanel Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PadName" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PadConnection" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PadInUse" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PadConnected" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PadEvents" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Margin="0,0,24,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.InputControllerHeader}" />
                            <ui:TextBlock Grid.Column="1" Margin="0,0,24,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.InputConnectionHeader}" />
                            <ui:TextBlock Grid.Column="2" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.InputInUseHeader}" />
                            <ui:TextBlock Grid.Column="3" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.InputConnectedHeader}" />
                            <ui:TextBlock Grid.Column="4" Margin="0,0,24,4" FontTypography="BodyStrong" TextAlignment="Right" Text="{x:Static vm:SessionSummaryViewModel.InputEventsHeader}" />
                            <ui:TextBlock Grid.Column="5" Margin="0,0,0,4" FontTypography="BodyStrong" Text="{x:Static vm:SessionSummaryViewModel.InputBatteryColumnHeader}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ViewModel.InputControllers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InputControllerRowModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PadName" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PadConnection" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PadInUse" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PadConnected" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PadEvents" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" Margin="0,2,24,2" Text="{Binding Name}" />
                                        <ui:TextBlock Grid.Column="1" Margin="0,2,24,2" Text="{Binding Connection}" />
                                        <ui:TextBlock Grid.Column="2" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding InUse}" />
                                        <ui:TextBlock Grid.Column="3" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Connected}" />
                                        <ui:TextBlock Grid.Column="4" Margin="0,2,24,2" TextAlignment="Right" Text="{Binding Events}" />
                                        <ui:TextBlock Grid.Column="5" Margin="0,2,0,2" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding Battery}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputMakers}"
                                  Visibility="{Binding ViewModel.InputMakers, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Text="{Binding ViewModel.InputNotes}"
                              Visibility="{Binding ViewModel.InputNotes, Converter={StaticResource NullToCollapsed}}" />

                <!-- the input series over the session, from its start: what each second was played with, then each battery -->
                <StackPanel Visibility="{Binding ViewModel.HasInputCharts, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,12,0,0" FontTypography="BodyStrong" AutomationProperties.HeadingLevel="Level3" Text="{x:Static vm:SessionSummaryViewModel.InputTimelineHeader}" />
                    <charts:InputTimelineChart x:Name="InputTimeline" Margin="0,6,0,0" Height="200" />
                </StackPanel>
                <StackPanel Visibility="{Binding ViewModel.HasInputBattery, Converter={StaticResource BoolToVis}}">
                    <ui:TextBlock Margin="0,12,0,0" FontTypography="BodyStrong" AutomationProperties.HeadingLevel="Level3" Text="{x:Static vm:SessionSummaryViewModel.InputBatteryHeader}" />
                    <charts:InputBatteryChart x:Name="InputBattery" Margin="0,6,0,0" Height="200" />
                </StackPanel>

                <!-- annotations -->
                <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" AutomationProperties.HeadingLevel="Level2" Text="{x:Static vm:SessionSummaryViewModel.AnnotationsHeader}" />
                <ui:TextBox Margin="0,6,0,0" AutomationProperties.Name="{x:Static vm:SessionSummaryViewModel.TagsPlaceholder}" PlaceholderText="{x:Static vm:SessionSummaryViewModel.TagsPlaceholder}" Text="{Binding ViewModel.Tags, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox Margin="0,6,0,0" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                            AutomationProperties.Name="{x:Static vm:SessionSummaryViewModel.NotesPlaceholder}"
                            PlaceholderText="{x:Static vm:SessionSummaryViewModel.NotesPlaceholder}" Text="{Binding ViewModel.Notes, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Primary" Command="{Binding ViewModel.SaveAnnotationCommand}" Content="{x:Static vm:SessionSummaryViewModel.SaveText}" Icon="{ui:SymbolIcon Save24}" />
                    <ui:Button Margin="16,0,0,0" Command="{Binding ViewModel.ExportCsvCommand}" Content="{x:Static vm:SessionSummaryViewModel.ExportCsvText}" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.ExportJsonCommand}" Content="{x:Static vm:SessionSummaryViewModel.ExportJsonText}" />
                    <ui:Button Margin="8,0,0,0" Click="OnExportPng" Content="{x:Static vm:SessionSummaryViewModel.ExportPngText}"
                               IsEnabled="{Binding ViewModel.IsHooked}" />
                    <!-- Advanced metrics (D101): only for a session recorded with the option on; it opens that session on the page. -->
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.OpenAdvancedCommand}" Content="{x:Static vm:SessionSummaryViewModel.AdvancedText}"
                               Visibility="{Binding ViewModel.HasAdvanced, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="1" Focusable="False" />
    </Grid>
</ui:FluentWindow>
