<ui:FluentWindow x:Class="FrameLedger.App.Windows.FirstRunWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
                 Title="{x:Static vm:FirstRunViewModel.Title}"
                 Width="900"
                 Height="680"
                 MinWidth="700"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- 08_UI §First-run flow, FR-11: shown before the shell; closing it without a decision is a decline. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{x:Static vm:FirstRunViewModel.Title}" ShowMaximize="True" ShowMinimize="False" />
        <ContentPresenter x:Name="Host" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
