<UserControl x:Class="FrameLedger.App.Charts.DistributionChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="240">
    <!-- FR-5.1: the FPS histogram and the percentile curve, side by side. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <sp:WpfPlot x:Name="Histogram" Grid.Column="0" />
        <sp:WpfPlot x:Name="Percentiles" Grid.Column="2" />
    </Grid>
</UserControl>
