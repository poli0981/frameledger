<UserControl x:Class="FrameLedger.App.Charts.DistributionChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:charts="clr-namespace:FrameLedger.App.Charts"
             xmlns:res="clr-namespace:FrameLedger.App"
             MinHeight="240">
    <!-- FR-5.1: the FPS histogram and the percentile curve, side by side; the note says what the histogram's range left out (beta.8). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <charts:ChartPlot x:Name="Histogram" AutomationProperties.Name="{x:Static res:Strings.A11y_Chart_Histogram}" AutomationProperties.HelpText="{x:Static res:Strings.A11y_ChartData_Summary}" Grid.Column="0" />
        <charts:ChartPlot x:Name="Percentiles" AutomationProperties.Name="{x:Static res:Strings.A11y_Chart_Percentiles}" AutomationProperties.HelpText="{x:Static res:Strings.A11y_ChartData_Summary}" Grid.Column="2" />
        <ui:TextBlock x:Name="Note" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</UserControl>
