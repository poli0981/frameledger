<UserControl x:Class="FrameLedger.App.Charts.InputBatteryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:FrameLedger.App"
             xmlns:charts="clr-namespace:FrameLedger.App.Charts">
    <!-- 08_UI §Session summary (0.1.0-beta.50): each controller's battery over the session, as steps; a line saying none was
         read where no controller reported one. -->
    <Grid>
        <charts:ChartPlot x:Name="Plot" AutomationProperties.Name="{x:Static res:Strings.A11y_Chart_InputBattery}" AutomationProperties.HelpText="{x:Static res:Strings.A11y_ChartData_Input}" />
        <ui:TextBlock x:Name="NotRead" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Text="{x:Static res:Strings.Chart_InputBattery_NotRead}" Visibility="Collapsed" />
    </Grid>
</UserControl>
