<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF UI (docs/08_UI.md). All XAML follows docs/16_WPFUI_SYNTAX.md — read it
    before writing any view. All user-visible strings come from .resx
    (docs/09_I18N.md); no string literals in XAML or C#.

    The strongly-typed accessor Strings.Designer.cs is GENERATED from Strings.resx by
    tools/resx-gen.ps1 and committed; tools/resx-audit.ps1 (build.ps1 step 15) fails the
    build when it is stale or when Strings.vi.resx / Strings.ja.resx drift from the
    neutral key set. The SDK embeds the resx as FrameLedger.App.Strings.resources and
    builds the vi/ja satellites on its own (SatelliteResourceLanguages in Directory.Build.props).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>FrameLedger</AssemblyName>
    <RootNamespace>FrameLedger.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NFR-9: Per-Monitor V2. Declared in app.manifest; kept here as the
         reminder that it is a requirement, not a default. -->
    <!-- 11_UPDATER (P4 PR-5): Velopack must run before any window exists, so the
         entry point is Program.Main rather than the generated App.Main. -->
    <StartupObject>FrameLedger.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Infrastructure\FrameLedger.Infrastructure.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The view models and services are internal-ish by intent; the test project pins them. -->
    <InternalsVisibleTo Include="FrameLedger.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-11 (P3 PR-9): the Legal Gate shows exactly the documents this build was reviewed with, so they are
         embedded here from the repository's legal/ and LICENSE rather than read from a folder at run time.
         {{RELEASE_DATE}} stays as written until release.yml substitutes it (12_BUILD §Release-time token substitution). -->
    <EmbeddedResource Include="..\..\legal\EULA.md" LogicalName="legal/EULA.md" />
    <EmbeddedResource Include="..\..\legal\DISCLAIMER.md" LogicalName="legal/DISCLAIMER.md" />
    <EmbeddedResource Include="..\..\legal\PRIVACY_POLICY.md" LogicalName="legal/PRIVACY_POLICY.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <!-- P4 PR-6: the licence texts travel with the package (legal/THIRD_PARTY_NOTICES.md: "Full license texts must be
         shipped in legal/licenses/ in release packages"). PUBLISH ONLY: a build output has no recipient, and copying
         ~1 MB into every bin/ and test run would be noise. The App publishes into the same out/app as the Agent, so
         one copy covers both. release.yml adds the .NET runtime's own licence and notices beside these. -->
    <None Include="..\..\legal\licenses\**\*" LinkBase="licenses" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\legal\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="licenses\FrameLedger-GPL-3.0.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.Abstractions" />
    <PackageReference Include="WPF-UI.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ScottPlot.WPF" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
