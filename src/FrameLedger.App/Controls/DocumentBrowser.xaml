<UserControl x:Class="FrameLedger.App.Controls.DocumentBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FrameLedger.App"
             xmlns:local="clr-namespace:FrameLedger.App.Controls"
             xmlns:services="clr-namespace:FrameLedger.App.Services">
    <!-- beta.12: a list of pages beside one rendered page; the list hides itself when there is one page. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- A long title wraps rather than being cut under a horizontal scroll bar (NOTICE's did, measured beta.12). -->
        <ListBox x:Name="PageList"
                 Grid.Column="0"
                 Width="230"
                 Margin="0,0,12,0"
                 AutomationProperties.Name="{x:Static res:Strings.Document_Pages}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnPageSelected">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type services:DocumentPage}">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" BorderThickness="1" CornerRadius="4" Padding="8,6,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <local:MarkdownView x:Name="View" />
        </Border>
    </Grid>
</UserControl>
