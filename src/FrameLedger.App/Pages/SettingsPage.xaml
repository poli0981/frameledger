<Page x:Class="FrameLedger.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:FrameLedger.App"
      xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
      Title="{x:Static res:Strings.Settings_Header}">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock FontTypography="Title" Text="{x:Static vm:SettingsViewModel.Header}" />

            <!-- 08_UI §Settings: Capture first, most important — the kill switch, the hook-enabled games, the layer, the safety link. -->
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Capture_Header}" />
            <ui:CardExpander Margin="0,4,0,0" IsExpanded="True" Icon="{ui:SymbolIcon ShieldError24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_KillSwitch_Label}" />
                            <ui:TextBlock Appearance="Secondary" Text="{Binding ViewModel.KillSwitchState}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0" AutomationProperties.Name="{x:Static res:Strings.Settings_KillSwitch_Label}" IsChecked="{Binding ViewModel.KillSwitch, Mode=TwoWay}" />
                    </Grid>
                </ui:CardExpander.Header>
                <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_KillSwitch_Body}" TextWrapping="Wrap" />
            </ui:CardExpander>

            <ui:CardExpander Margin="0,8,0,0" IsExpanded="True" Icon="{ui:SymbolIcon Games24}" Header="{x:Static res:Strings.Settings_HookedGames_Label}">
                <StackPanel>
                    <ui:TextBlock Appearance="Secondary"
                                  Text="{x:Static res:Strings.Settings_HookedGames_Empty}"
                                  Visibility="{Binding ViewModel.HookedGames.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.HookedGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <ui:Button Grid.Column="1"
                                               Appearance="Secondary"
                                               Command="{Binding RevokeCommand}"
                                               Content="{x:Static res:Strings.Settings_HookedGames_Revoke}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardExpander Margin="0,8,0,0" Icon="{ui:SymbolIcon Layer24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_VkLayer_Label}" />
                            <ui:TextBlock MaxWidth="520" HorizontalAlignment="Left" Appearance="Secondary" Text="{Binding ViewModel.VulkanLayerText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Secondary"
                                       Command="{Binding ViewModel.RegisterLayerCommand}"
                                       Content="{x:Static res:Strings.Settings_VkLayer_Register}"
                                       IsEnabled="{Binding ViewModel.CanRegisterLayer}" />
                            <ui:Button Appearance="Secondary"
                                       Command="{Binding ViewModel.UnregisterLayerCommand}"
                                       Content="{x:Static res:Strings.Settings_VkLayer_Unregister}"
                                       IsEnabled="{Binding ViewModel.CanUnregisterLayer}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>
                <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_VkLayer_Note}" TextWrapping="Wrap" />
            </ui:CardExpander>
            <ui:HyperlinkButton Margin="0,6,0,0"
                                Command="{Binding ViewModel.OpenSafetyDocsCommand}"
                                Content="{x:Static res:Strings.Settings_SafetyDocs}"
                                Icon="{ui:SymbolIcon Open24}" />

            <!-- Recording policy: the three numbers and background capture (D16: the Agent reads them at session start). -->
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Policy_Header}" />
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Timer24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_MinSession_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_MinSession_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox MinWidth="140"
                              AutomationProperties.Name="{x:Static res:Strings.Settings_MinSession_Label}"
                              Maximum="{x:Static vm:SettingsViewModel.MinSessionMaximum}"
                              Minimum="{x:Static vm:SettingsViewModel.MinSessionMinimum}"
                              SpinButtonPlacementMode="Inline"
                              Value="{Binding ViewModel.MinSessionSeconds, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon Pulse24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Interval_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_Interval_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox MinWidth="140"
                              AutomationProperties.Name="{x:Static res:Strings.Settings_Interval_Label}"
                              Maximum="{x:Static vm:SettingsViewModel.IntervalMaximum}"
                              Minimum="{x:Static vm:SettingsViewModel.IntervalMinimum}"
                              SpinButtonPlacementMode="Inline"
                              Value="{Binding ViewModel.TelemetryIntervalMs, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon Database24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Retention_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_Retention_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:NumberBox MinWidth="140"
                              AutomationProperties.Name="{x:Static res:Strings.Settings_Retention_Label}"
                              Maximum="{x:Static vm:SettingsViewModel.RetentionMaximum}"
                              Minimum="0"
                              SpinButtonPlacementMode="Inline"
                              Value="{Binding ViewModel.RetentionRawSessions, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon Eye24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Background_Label}" />
                        <ui:TextBlock MaxWidth="560" HorizontalAlignment="Left" Appearance="Secondary" Text="{x:Static res:Strings.Settings_Background_Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_Background_Label}" IsChecked="{Binding ViewModel.BackgroundCapture, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Agent: elevation is optional and no tier needs it; the logon task arrives with the tray build. -->
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Agent_Header}" />
            <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon Person24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Agent_Elevation_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{Binding ViewModel.ElevationText}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_Agent_Elevation_Body}" TextWrapping="Wrap" />
            </ui:CardExpander>
            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon CalendarClock24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_Agent_Task_Label}" />
                        <ui:TextBlock MaxWidth="520" HorizontalAlignment="Left" Appearance="Secondary" Text="{Binding ViewModel.TaskText}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Appearance="Secondary"
                               Command="{Binding ViewModel.InstallTaskCommand}"
                               Content="{x:Static res:Strings.Settings_Agent_Task_Register}"
                               IsEnabled="{Binding ViewModel.CanInstallTask}" />
                    <ui:Button Margin="0,0,8,0"
                               Appearance="Secondary"
                               Command="{Binding ViewModel.RepairTaskCommand}"
                               Content="{x:Static res:Strings.Settings_Agent_Task_Repair}"
                               IsEnabled="{Binding ViewModel.CanRepairTask}" />
                    <ui:Button Appearance="Secondary"
                               Command="{Binding ViewModel.RemoveTaskCommand}"
                               Content="{x:Static res:Strings.Settings_Agent_Task_Remove}"
                               IsEnabled="{Binding ViewModel.CanRemoveTask}" />
                </StackPanel>
            </ui:CardControl>

            <!-- Appearance (PR-2) and window. -->
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static vm:SettingsViewModel.AppearanceHeader}" />
            <ui:CardControl Margin="0,4,0,0" Header="{x:Static vm:SettingsViewModel.ThemeLabel}" Icon="{ui:SymbolIcon Color24}">
                <ComboBox MinWidth="180"
                          AutomationProperties.Name="{x:Static vm:SettingsViewModel.ThemeLabel}"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                          SelectedValue="{Binding ViewModel.SelectedTheme, Mode=TwoWay}"
                          SelectedValuePath="Value" />
            </ui:CardControl>
            <ui:CardControl Margin="0,8,0,0" Header="{x:Static vm:SettingsViewModel.LanguageLabel}" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ComboBox MinWidth="180"
                          AutomationProperties.Name="{x:Static vm:SettingsViewModel.LanguageLabel}"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Static vm:SettingsViewModel.Languages}"
                          SelectedValue="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}"
                          SelectedValuePath="Value" />
            </ui:CardControl>
            <ui:TextBlock Margin="0,6,0,0" Appearance="Secondary" Text="{x:Static vm:SettingsViewModel.LanguageNote}" TextWrapping="Wrap" />

            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Window_Header}" />
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_StartWithWindows_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_StartWithWindows_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_StartWithWindows_Label}" IsChecked="{Binding ViewModel.StartWithWindows, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_MinimizeToTray_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_MinimizeToTray_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_MinimizeToTray_Label}" IsChecked="{Binding ViewModel.MinimizeToTray, Mode=TwoWay}" />
            </ui:CardControl>

            <!-- Privacy, updates, logging, legal. -->
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Privacy_Header}" />
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_OnlineMetadata_Label}" />
                        <ui:TextBlock MaxWidth="560" HorizontalAlignment="Left" Appearance="Secondary" Text="{x:Static res:Strings.Settings_OnlineMetadata_Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_OnlineMetadata_Label}" IsChecked="{Binding ViewModel.OnlineMetadata, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Updates_Header}" />
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_UpdateChannel_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_UpdateChannel_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="140"
                          AutomationProperties.Name="{x:Static res:Strings.Settings_UpdateChannel_Label}"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Static vm:SettingsViewModel.UpdateChannels}"
                          SelectedValue="{Binding ViewModel.UpdateChannel, Mode=TwoWay}"
                          SelectedValuePath="Value" />
            </ui:CardControl>
            <!-- 11_UPDATER §Flow (P4 PR-5): the startup silent check, "if enabled" — the one request rule 8 permits, and the user's to turn off. -->
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon CloudArrowDown24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_AutoCheck_Label}" />
                        <ui:TextBlock MaxWidth="560" HorizontalAlignment="Left" Appearance="Secondary" Text="{x:Static res:Strings.Settings_AutoCheck_Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_AutoCheck_Label}" IsChecked="{Binding ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Logging_Header}" />
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon Bug24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static res:Strings.Settings_LogDebug_Label}" />
                        <ui:TextBlock Appearance="Secondary" Text="{x:Static res:Strings.Settings_LogDebug_Body}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="{x:Static res:Strings.Settings_LogDebug_Label}" IsChecked="{Binding ViewModel.LogDebug, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static res:Strings.Settings_Legal_Header}" />
            <ui:CardAction Margin="0,4,0,24" Command="{Binding ViewModel.ReopenLegalCommand}" Icon="{ui:SymbolIcon DocumentText24}">
                <ui:TextBlock Text="{x:Static res:Strings.Settings_Legal_Reopen}" />
            </ui:CardAction>
        </StackPanel>
    </ScrollViewer>
</Page>
