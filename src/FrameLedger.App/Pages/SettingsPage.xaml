<Page x:Class="FrameLedger.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:FrameLedger.App"
      xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
      Title="{x:Static res:Strings.Settings_Header}">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock FontTypography="Title" Text="{x:Static vm:SettingsViewModel.Header}" />
            <ui:TextBlock FontTypography="Subtitle" Margin="0,20,0,8" Text="{x:Static vm:SettingsViewModel.AppearanceHeader}" />

            <!-- 08_UI §Settings: the WPF UI settings idiom — CardControl rows. -->
            <ui:CardControl Margin="0,4,0,0" Header="{x:Static vm:SettingsViewModel.ThemeLabel}" Icon="{ui:SymbolIcon Color24}">
                <ComboBox MinWidth="180"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                          SelectedValue="{Binding ViewModel.SelectedTheme, Mode=TwoWay}"
                          SelectedValuePath="Value" />
            </ui:CardControl>

            <ui:CardControl Margin="0,8,0,0" Header="{x:Static vm:SettingsViewModel.LanguageLabel}" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ComboBox MinWidth="180"
                          DisplayMemberPath="Label"
                          ItemsSource="{x:Static vm:SettingsViewModel.Languages}"
                          SelectedValue="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}"
                          SelectedValuePath="Value" />
            </ui:CardControl>
            <ui:TextBlock Margin="0,6,0,0" Appearance="Secondary" Text="{x:Static vm:SettingsViewModel.LanguageNote}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
