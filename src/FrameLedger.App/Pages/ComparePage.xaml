<Page x:Class="FrameLedger.App.Pages.ComparePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:FrameLedger.App"
      xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
      xmlns:controls="clr-namespace:FrameLedger.App.Controls"
      xmlns:charts="clr-namespace:FrameLedger.App.Charts"
      Title="{x:Static res:Strings.Compare_Header}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
    <!-- 08_UI §Compare: the picker (2–5, cross-game), the overlaid percentile curves, the stat table; FR-6.2's guard is the view model's. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <ui:TextBlock FontTypography="Title" Text="{x:Static vm:CompareViewModel.Header}" />
            <ui:TextBlock Margin="0,16,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="{x:Static vm:CompareViewModel.EmptyText}"
                          Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVis}}" />

            <!-- beta.34 (owner request 2026-11-06, D85): the filters - game, tier, frame generation - over every session, and how
                 many the list holds; a ticked session stays listed whatever they say. -->
            <WrapPanel Margin="0,16,0,0" Orientation="Horizontal"
                       Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ComboBox MinWidth="220" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Compare_Filter_Game}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.Games}"
                          SelectedValue="{Binding ViewModel.GameFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="180" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Compare_Filter_Tier}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.Tiers}"
                          SelectedValue="{Binding ViewModel.TierFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="240" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Compare_Filter_Fg}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.FrameGenerationChoices}"
                          SelectedValue="{Binding ViewModel.FrameGenerationFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ui:Button Margin="0,0,16,8" VerticalAlignment="Center" Appearance="Secondary"
                           Command="{Binding ViewModel.ClearFiltersCommand}"
                           Content="{x:Static vm:CompareViewModel.ClearFiltersText}" Icon="{ui:SymbolIcon FilterDismiss24}" />
                <ui:TextBlock Margin="0,0,0,8" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding ViewModel.CountText}" />
            </WrapPanel>

            <!-- beta.34: the selection bar beside what it acts on - it sat at the window's far right, a full width away from the list. -->
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal"
                        Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ui:TextBlock Margin="0,0,16,0" VerticalAlignment="Center" FontTypography="Subtitle" Text="{x:Static vm:CompareViewModel.PickHeader}" />
                <ui:TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding ViewModel.SelectedText}" />
                <ui:Button Margin="0,0,8,0" Appearance="Secondary" Command="{Binding ViewModel.ClearSelectionCommand}"
                           Content="{x:Static vm:CompareViewModel.ClearSelectionText}" />
                <ui:Button Appearance="Primary" Command="{Binding ViewModel.CompareCommand}" IsEnabled="{Binding ViewModel.CanCompare}"
                           Content="{x:Static vm:CompareViewModel.RunText}" Icon="{ui:SymbolIcon ArrowSwap24}" />
            </StackPanel>

            <!--
                beta.34: columns sized to what they hold, and one filler column after them - three star columns spread a wide
                window into gaps, and the Tier column was exactly its header's width, so "Tier" and "FPS" touched. The date sorts
                by when, not by its text; the settings-changed cell says so in words, or shows a dash.
            -->
            <DataGrid Margin="0,8,0,0" MaxHeight="320" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      ItemsSource="{Binding ViewModel.Candidates}" SelectionMode="Single"
                      Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <DataGrid.Columns>
                    <!-- A template column, not DataGridCheckBoxColumn: that one's element style is WPF's own, an Aero2 box on the Fluent grid; MinWidth 0
                         and no padding, or WPF UI's CheckBox (MinWidth 120, padding 11) draws a sliver of the box in 40 px (beta.14). -->
                    <DataGridTemplateColumn Width="40" controls:CellName.Path="Label">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CompareCandidateViewModel}">
                                <CheckBox MinWidth="0" Padding="0" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:Strings.Compare_Col_Game}" Binding="{Binding GameName}" IsReadOnly="True" Width="Auto" MinWidth="220" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Compare_Col_Date}" Binding="{Binding DateText}" SortMemberPath="StartedAt" IsReadOnly="True" Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Compare_Col_Tier}" Binding="{Binding TierText}" IsReadOnly="True" Width="Auto" MinWidth="64" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Compare_Col_Fps}" Binding="{Binding ReadoutLine}" IsReadOnly="True" Width="Auto" MinWidth="220" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Compare_Col_MidSession}" IsReadOnly="True" Width="Auto" MinWidth="150" SortMemberPath="SettingsChangedMidSession" controls:CellName.Path="SettingsChangedText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:CompareCandidateViewModel}">
                                <StackPanel Margin="4,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding SettingsChangedMidSession, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SettingsChangedText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- the filler: the width the columns above do not need, so they stay together on a wide window -->
                    <DataGridTemplateColumn Width="*" CanUserSort="False" CanUserResize="False" IsReadOnly="True" controls:CellName.Path="Label" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Visibility="{Binding ViewModel.HasResult, Converter={StaticResource BoolToVis}}">
                <ui:InfoBar Margin="0,12,0,0" IsClosable="False" Severity="Warning"
                            IsOpen="{Binding ViewModel.IsMixed, Mode=OneWay}"
                            Title="{x:Static res:Strings.Compare_Mixed_Title}"
                            Message="{Binding ViewModel.TierLegend}" />
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="Subtitle" Text="{x:Static vm:CompareViewModel.CurvesHeader}" />
                    <ui:Button Grid.Column="1" Click="OnExportPng" Content="{x:Static vm:CompareViewModel.ExportPngText}" />
                </Grid>
                <charts:CompareChart x:Name="Chart" Margin="0,6,0,0" Height="340" />

                <ui:TextBlock Margin="0,16,0,0" FontTypography="Subtitle" Text="{x:Static vm:CompareViewModel.TableHeader}" />
                <!-- the header row: the metric column's own header, then one label per compared session - laid out as every row
                     below is (a 140-px metric cell, then the sessions sharing the rest), so each label sits over its column;
                     beta.34: it spread over the whole width, the 140 px included, and drifted left of its values. -->
                <DockPanel Margin="0,6,0,0">
                    <ui:TextBlock DockPanel.Dock="Left" Width="140" Style="{StaticResource SecondaryText}" FontTypography="Caption"
                                  Text="{x:Static vm:CompareViewModel.MetricHeader}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Compared}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CompareCandidateViewModel}">
                                <ui:TextBlock Margin="4,0" Style="{StaticResource SecondaryText}" FontTypography="Caption" TextWrapping="Wrap" Text="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ViewModel.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CompareRowViewModel}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                                <DockPanel>
                                    <ui:TextBlock DockPanel.Dock="Left" Width="140" Style="{StaticResource SecondaryText}" Text="{Binding Metric}" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CompareCell}">
                                                <!-- The default foreground is the Style's, not a local value (beta.8): a local value outranks every
                                                     trigger, and the best cell was bold but never in the accent colour. -->
                                                <TextBlock Margin="4,0" Text="{Binding Text}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
