<Page x:Class="FrameLedger.App.Pages.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:FrameLedger.App"
      xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
      xmlns:controls="clr-namespace:FrameLedger.App.Controls"
      Title="{x:Static res:Strings.Games_Header}"
      AllowDrop="True"
      Drop="OnDrop"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False">
    <!--
        08_UI §Games: search, sort, FR-1.1 add by pick or by dropping an .exe here. Since beta.11 (owner requests 2026-10-03):
        the count in the title; a grid of cards that fills the width (UniformWrapPanel - a WrapPanel of 300 px cards left a
        card's width unused at the right) or a list (ui.library_view); Refresh reads the library again, offers the games the
        stores installed since, and marks the entries whose executable is gone.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRoot}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="Title" AutomationProperties.HeadingLevel="Level1" Text="{Binding ViewModel.HeaderText}" />
                <ui:TextBox Grid.Column="1" MinWidth="220" Margin="0,0,12,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static vm:GamesViewModel.SearchPlaceholder}"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{x:Static vm:GamesViewModel.SearchPlaceholder}"
                            Text="{Binding ViewModel.Search, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="2" MinWidth="150" Margin="0,0,12,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Sort}"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding ViewModel.Sorts}"
                          SelectedValue="{Binding ViewModel.Sort, Mode=TwoWay}"
                          SelectedValuePath="Value" />
                <!-- The view switch: the one button shown is the other view. -->
                <StackPanel Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Command="{Binding ViewModel.ShowListCommand}" Icon="{ui:SymbolIcon AppsList24}"
                               ToolTip="{x:Static vm:GamesViewModel.ListText}" AutomationProperties.Name="{x:Static vm:GamesViewModel.ListText}"
                               Visibility="{Binding ViewModel.ListView, Converter={StaticResource InverseBoolToVis}}" />
                    <ui:Button Appearance="Secondary" Command="{Binding ViewModel.ShowGridCommand}" Icon="{ui:SymbolIcon Grid24}"
                               ToolTip="{x:Static vm:GamesViewModel.GridText}" AutomationProperties.Name="{x:Static vm:GamesViewModel.GridText}"
                               Visibility="{Binding ViewModel.ListView, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ui:Button Grid.Column="4" Margin="0,0,12,0" Appearance="Secondary" VerticalAlignment="Center"
                           Command="{Binding ViewModel.RefreshCommand}"
                           Content="{x:Static vm:GamesViewModel.RefreshText}"
                           ToolTip="{x:Static vm:GamesViewModel.RefreshToolTip}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button Grid.Column="5" Appearance="Primary" VerticalAlignment="Center"
                           Command="{Binding ViewModel.AddGameCommand}"
                           Content="{x:Static vm:GamesViewModel.AddText}"
                           Icon="{ui:SymbolIcon Add24}" />
            </Grid>

            <!-- beta.34 (owner request 2026-11-06, D85): the filters - store, engine, state, installed, played - beside the search
                 and sort above; each list names its "everything" first, and the stores and engines are the library's own. -->
            <WrapPanel Margin="0,12,0,0" Orientation="Horizontal"
                       Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                <ComboBox MinWidth="150" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Filter_Store}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.Stores}"
                          SelectedValue="{Binding ViewModel.StoreFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="170" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Filter_Engine}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.Engines}"
                          SelectedValue="{Binding ViewModel.EngineFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="150" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Filter_State}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.States}"
                          SelectedValue="{Binding ViewModel.StateFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="150" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Filter_Installed}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.InstalledChoices}"
                          SelectedValue="{Binding ViewModel.InstalledFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ComboBox MinWidth="150" Margin="0,0,8,8" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static res:Strings.A11y_Games_Filter_Played}"
                          DisplayMemberPath="Label" ItemsSource="{Binding ViewModel.PlayedChoices}"
                          SelectedValue="{Binding ViewModel.PlayedFilter, Mode=TwoWay}" SelectedValuePath="Value" />
                <ui:Button Margin="0,0,0,8" VerticalAlignment="Center" Appearance="Secondary"
                           Command="{Binding ViewModel.ClearFiltersCommand}"
                           Content="{x:Static vm:GamesViewModel.ClearFiltersText}"
                           Icon="{ui:SymbolIcon FilterDismiss24}" />
            </WrapPanel>

            <ui:TextBlock Margin="0,16,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                          Text="{x:Static vm:GamesViewModel.EmptyText}"
                          Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ui:TextBlock Margin="0,16,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                          Text="{x:Static vm:GamesViewModel.NoMatchText}"
                          Visibility="{Binding ViewModel.NoMatch, Converter={StaticResource BoolToVis}}" />

            <!-- The grid: as many columns as fit at 300 px or wider, each card an equal share of the width. -->
            <ItemsControl x:Name="CardGrid" Margin="0,16,0,0" ItemsSource="{Binding ViewModel.Games}"
                          Visibility="{Binding ViewModel.ListView, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:UniformWrapPanel MinItemWidth="300" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                        <Grid>
                            <ui:CardAction IsChevronVisible="False" VerticalAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding AccessibleName}"
                                           Command="{Binding DataContext.ViewModel.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Games24}">
                                <StackPanel>
                                    <ui:TextBlock Margin="0,0,40,0" FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <!-- Pills wrap to a second line rather than being cut (the third one was, at 300 px). -->
                                    <WrapPanel Margin="0,4,0,0">
                                        <Border Style="{StaticResource TagPill}" Margin="0,0,6,4"
                                                Visibility="{Binding HasPlatform, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource TagPillText}" Text="{Binding PlatformText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagPill}" Margin="0,0,6,4"
                                                Visibility="{Binding HasEngine, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource TagPillText}" Text="{Binding EngineText}" />
                                        </Border>
                                        <Border Style="{StaticResource HookStatePill}" Margin="0,0,6,4">
                                            <TextBlock Style="{StaticResource HookStatePillText}" Text="{Binding HookText}" />
                                        </Border>
                                        <Border x:Name="NotInstalledPill" Style="{StaticResource TagPill}" Margin="0,0,6,4"
                                                ToolTip="{Binding NotInstalledToolTip}"
                                                Visibility="{Binding NotInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource TagPillText}" Text="{x:Static res:Strings.Games_Card_NotInstalled}" />
                                        </Border>
                                    </WrapPanel>
                                    <ui:TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryText}" Text="{Binding SessionsText}" />
                                    <ui:TextBlock Style="{StaticResource SecondaryText}" Text="{Binding PlaytimeText}" />
                                    <ui:TextBlock Style="{StaticResource SecondaryText}" Text="{Binding LastPlayedText}" />
                                </StackPanel>
                            </ui:CardAction>
                            <!-- beta.21 (D59): Play, over the card's corner rather than inside it, so the card stays one button. -->
                            <ui:Button Margin="0,10,10,0" Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       AutomationProperties.Name="{Binding PlayName}"
                                       Command="{Binding DataContext.ViewModel.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       Icon="{ui:SymbolIcon Play24}"
                                       IsEnabled="{Binding DataContext.ViewModel.ActsOnThisPc, RelativeSource={RelativeSource AncestorType=Page}}"
                                       ToolTip="{Binding DataContext.ViewModel.PlayToolTip, RelativeSource={RelativeSource AncestorType=Page}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The list: one row per game across the width; double-click or Enter opens it. Bounded since beta.34, as the
                 Sessions grid is since beta.23: inside the page's scroller it was measured with no height limit and built every
                 row, a Play button each (spike-notes §21, §27). -->
            <DataGrid x:Name="GameList" Margin="0,16,0,0" MaxHeight="640" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single"
                      ItemsSource="{Binding ViewModel.Games}"
                      MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown"
                      Visibility="{Binding ViewModel.ListView, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <!-- beta.21 (D59): Play, as on the cards. -->
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Play_Button}" Width="Auto" controls:CellName.Path="PlayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Margin="2,0" Padding="6,2" Appearance="Transparent"
                                           AutomationProperties.Name="{Binding PlayName}"
                                           Command="{Binding DataContext.ViewModel.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"
                                           Icon="{ui:SymbolIcon Play24}"
                                           IsEnabled="{Binding DataContext.ViewModel.ActsOnThisPc, RelativeSource={RelativeSource AncestorType=Page}}"
                                           ToolTip="{Binding DataContext.ViewModel.PlayToolTip, RelativeSource={RelativeSource AncestorType=Page}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_Name}" Binding="{Binding Name}" Width="3*" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_Store}" Binding="{Binding PlatformText}" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_Engine}" Binding="{Binding EngineText}" Width="*" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Games_List_Status}" Width="*" controls:CellName.Path="StatusText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding StatusText}" ToolTip="{Binding NotInstalledToolTip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_Sessions}" Binding="{Binding SessionCount}" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_Played}" Binding="{Binding PlaytimeValue}" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Games_List_LastPlayed}" Binding="{Binding LastPlayedValue}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
