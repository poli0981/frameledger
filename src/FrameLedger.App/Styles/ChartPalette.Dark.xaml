<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The chart palette for the dark theme (16_WPFUI_SYNTAX §Theming: the one place hex colours are allowed,
        because ScottPlot draws with Skia and cannot read a WPF brush). ChartPalette.Light.xaml carries the same
        keys; ChartPaletteTests fails when the two drift. Read by Charts/ChartPalette, applied by Charts/ChartTheme.
    -->
    <Color x:Key="Chart_Figure">#00000000</Color>
    <Color x:Key="Chart_Data">#1A1A1A1A</Color>
    <Color x:Key="Chart_Axis">#FFB0B0B0</Color>
    <Color x:Key="Chart_Grid">#33FFFFFF</Color>
    <Color x:Key="Chart_Native">#FF4CC2FF</Color>
    <Color x:Key="Chart_Displayed">#FFB48CFF</Color>
    <Color x:Key="Chart_Stutter">#FFFF6B6B</Color>
    <Color x:Key="Chart_StutterPso">#FFFFB347</Color>
    <Color x:Key="Chart_Sensor">#FF7BD88F</Color>
    <Color x:Key="Chart_SensorSecondary">#FFE0C060</Color>
    <Color x:Key="Chart_Segment">#2260CDFF</Color>
    <Color x:Key="Chart_Histogram">#CC4CC2FF</Color>
    <!-- Not a second gold beside Chart_SensorSecondary (beta.8): the Sensors tab draws both. -->
    <Color x:Key="Chart_Percentile">#FFFF79C6</Color>
</ResourceDictionary>
