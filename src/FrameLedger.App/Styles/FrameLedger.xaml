<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:FrameLedger.App.Controls"
                    xmlns:converters="clr-namespace:FrameLedger.App.Converters">
    <!--
        Our styles, merged LAST (16_WPFUI_SYNTAX §App bootstrap). Colours only through theme brushes with
        DynamicResource; the chart palette (16 §Theming) arrives with the charts (P3 PR-6) as its own dictionary.
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <converters:NotNullConverter x:Key="NotNull" />

    <Style x:Key="PageRoot" TargetType="StackPanel">
        <Setter Property="Margin" Value="28,20,28,20" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,16,6" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A small pill: the factor chip, the census qualifier, the tier badge. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        FpsReadout (08_UI §FPS display rule). Generated: Native primary, Displayed second, the factor as an accent
        chip. None: the number alone. Presented: the number with the census qualifier chip — muted, or a warning
        when a frame-generation runtime was loaded / the counted none was withheld.
    -->
    <Style TargetType="{x:Type controls:FpsReadout}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FpsReadout}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Model.QualifierTooltip, RelativeSource={RelativeSource TemplatedParent}}">
                        <ui:TextBlock FontTypography="Subtitle" VerticalAlignment="Center" Text="{Binding Model.Line, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Factor" Style="{StaticResource Pill}" Background="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0"
                                Visibility="Collapsed">
                            <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Model.FactorChip, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <Border x:Name="Qualifier" Style="{StaticResource Pill}" Visibility="Collapsed">
                            <TextBlock x:Name="QualifierText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Model.QualifierText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Generated">
                            <Setter TargetName="Factor" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Presented">
                            <Setter TargetName="Qualifier" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.QualifierIsWarning, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Qualifier" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="QualifierText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TriStateChip (08_UI §Tri-state feature chips): Yes filled accent · No outlined · N/A dashed, muted. -->
    <Style TargetType="{x:Type controls:TriStateChip}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TriStateChip}">
                    <Grid ToolTip="{Binding Model.SourceText, RelativeSource={RelativeSource TemplatedParent}}">
                        <Rectangle x:Name="Dashes" RadiusX="12" RadiusY="12" StrokeDashArray="2 2" StrokeThickness="1"
                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed" />
                        <Border x:Name="Fill" CornerRadius="12" Padding="10,3" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                            <TextBlock x:Name="Text" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Model.Text, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsYes, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsNotApplicable, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
