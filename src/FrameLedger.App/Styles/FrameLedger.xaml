<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:FrameLedger.App.Controls"
                    xmlns:converters="clr-namespace:FrameLedger.App.Converters"
                    xmlns:services="clr-namespace:FrameLedger.App.Services"
                    xmlns:res="clr-namespace:FrameLedger.App">
    <!--
        Our styles, merged LAST (16_WPFUI_SYNTAX §App bootstrap). Colours only through theme brushes with
        DynamicResource; the chart palette (16 §Theming) arrives with the charts (P3 PR-6) as its own dictionary.
    -->
    <ResourceDictionary.MergedDictionaries>
        <!-- beta.34: the pane item's sizes (FlLeftFluentNavigationViewItemTemplate, below), as WPF UI's own template reads them. -->
        <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Controls/NavigationView/NavigationViewConstants.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <converters:NotNullConverter x:Key="NotNull" />
    <converters:ZeroToVisibleConverter x:Key="ZeroToVisible" />

    <!--
        beta.35 (D91): a destructive button. WPF UI 4.3.0's Danger appearance paints a fixed #F44336 — a value in its button
        style, not a resource the contrast overlay can reach — so under a Windows contrast theme the button is the theme's own
        button, as every button there is; its words and its icon still say what it does.
    -->
    <Style x:Key="DangerButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Danger" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(services:ContrastTheme.IsOn)}" Value="True">
                <Setter Property="Appearance" Value="Secondary" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageRoot" TargetType="StackPanel">
        <Setter Property="Margin" Value="28,20,28,20" />
    </Style>

    <!--
        Secondary and tertiary text (beta.17). These replace `ui:TextBlock Appearance="Secondary|Tertiary"`, which WPF UI
        4.3.0 resolves ONCE: TextBlock.OnAppearanceChanged stores TryFindResource(…) in AppearanceForeground and
        TextBlockMetadata coerces Foreground to it, so a text kept the theme it was made under. The owner's screenshots of
        2026-10-07 showed Settings' descriptions light grey on white after Dark → Light, and dark grey on dark after the way
        back. These follow a switch, like every other brush here (DynamicResource). ContrastTests.NoTextBlockTakesItsColourFromAppearance
        refuses Appearance on a TextBlock; PagesLoadTests.EveryTextFollowsAThemeSwitch renders every surface through a switch.
    -->
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TertiaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,16,6" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A small pill: the factor chip, the census qualifier, the tier badge. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        A neutral tag: the Games card's platform and engine, the edit dialog's "detected" marker. It WAS
        `ui:Badge Appearance="Secondary"` until 2026-09-21. WPF UI 4.3.0's Secondary trigger repaints only the badge's
        background (ControlFillColorDefault) and leaves Foreground at BadgeForeground, the on-accent colour of the DEFAULT
        badge: in the light theme that is near-white text on a near-white fill, and the owner's screenshot showed two empty
        white boxes beside a readable hooking pill. The hooking pill was readable because it sets its own foreground; so
        does this. ContrastTests measures the pair in both themes and refuses Secondary badges in App XAML.
    -->
    <Style x:Key="TagPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="TagPillText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        The Games card's hooking state (08_UI §Games). Two states, both from the theme dictionaries: ON is the accent
        pair the ×FG chip uses, OFF is the Pill's own muted fill with secondary text. It WAS `ui:Badge Appearance="Info"`
        until 2026-09-16, whose background is WPF UI's PaletteLightBlueBrush — a fixed Material colour outside the
        theme dictionaries, white-on-#03A9F4 in dark, 2.6:1 — which is the one way to break contrast that
        AccessibilityTests.NoXamlHardCodesAColour cannot see (08_UI §Contrast). ContrastTests holds both pairs now.
        A third state since 2026-09-25 (beta.8): "Anti-cheat", a guard finding on the row, on the caution fill with
        primary text — the warning qualifier's pair, which ContrastTests already measures in both themes.
    -->
    <Style x:Key="HookStatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HookOn}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AntiCheat}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HookStatePillText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HookOn}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AntiCheat}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ui:InfoBar, re-templated (16_WPFUI_SYNTAX §Gotchas). WPF UI 4.3.0's own template has no ContentPresenter,
        so an InfoBar's Content (the action button 08_UI §Notifications policy puts on every persistent banner)
        was never rendered: a refusal showed as a red bar with neither the "record this session without measuring
        it" button nor (IsClosable="False" by design) a close X. This is the upstream template verbatim (MIT,
        legal/licenses/wpfui-MIT.txt) plus one column: the ContentPresenter before the close button, collapsed
        when there is no content. PagesLoadTests.TheInfoBarTemplateRendersItsContent renders both templates and
        fails the day upstream gains a ContentPresenter, so this copy is removed rather than kept out of habit.
    -->
    <!--
        beta.35 (D88): what a screen reader is given. A plain ItemsControl is a Tab stop that holds nothing to say (WPF makes it
        focusable; its items' own controls take the focus); WPF UI's Image and CardControl take the focus with no automation
        peer or with an empty name - a Tab stop Narrator says nothing about; a CardExpander's expand button has no name. The
        App's lists, pictures and setting rows are not stops; an expander's button is named after its header
        (Controls/ExpanderToggleName). PagesLoadTests.Automation holds all four.
    -->
    <Style TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="{x:Type ui:Image}" BasedOn="{StaticResource DefaultImageStyle}">
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="{x:Type ui:CardControl}" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
        <Setter Property="controls:ExpanderToggleName.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="{x:Type ui:InfoBar}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource InfoBarTitleForeground}" />
        <Setter Property="Padding" Value="14,8,14,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:InfoBar}">
                    <Grid x:Name="InfoBarRoot">
                        <Border x:Name="ContentBorder" Padding="16,12"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,2,14,0" VerticalAlignment="Top">
                                    <ui:SymbolIcon x:Name="SymbolIcon" VerticalAlignment="Top" Filled="True" FontSize="16" />
                                </Border>
                                <!--
                                    beta.35 (D88): the title and the message through ContentPresenters. A TextBlock written straight
                                    into a template is hidden from the control view of the UI Automation tree (its templated parent is
                                    the InfoBar, which has no peer), so a safety notice's words reached no screen reader; a text a
                                    ContentPresenter makes is a control element.
                                -->
                                <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                                    <ContentPresenter x:Name="TitleText" Margin="0,0,14,0" Content="{TemplateBinding Title}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="SemiBold">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                    <ContentPresenter Margin="0" Content="{TemplateBinding Message}" TextElement.FontSize="{TemplateBinding FontSize}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </WrapPanel>
                                <!-- The one addition: the InfoBar's Content, which is where the action button goes. -->
                                <ContentPresenter x:Name="ActionContent" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                <Border Grid.Column="3" Margin="12,-2,0,0" VerticalAlignment="Top">
                                    <ui:Button x:Name="CloseButton" Padding="4" Background="Transparent" BorderThickness="0" IsEnabled="True"
                                               AutomationProperties.Name="{x:Static res:Strings.Common_Close}"
                                               Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ActionContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="SymbolIcon" Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarInformationalSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarSuccessSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarWarningSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarErrorSeverityBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        FpsReadout (08_UI §FPS display rule). Generated: Native primary, Displayed second, the factor as an accent
        chip. None: the number alone. Presented: the number with the census qualifier chip — muted, or a warning
        when a frame-generation runtime was loaded / the counted none was withheld.
    -->
    <Style TargetType="{x:Type controls:FpsReadout}">
        <!-- beta.35 (D88): shown, not operated - read through its peer (SpokenTextAutomationPeer), no Tab stop. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FpsReadout}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Model.QualifierTooltip, RelativeSource={RelativeSource TemplatedParent}}">
                        <ui:TextBlock FontTypography="Subtitle" AutomationProperties.HeadingLevel="None" VerticalAlignment="Center" Text="{Binding Model.Line, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Factor" Style="{StaticResource Pill}" Background="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0"
                                Visibility="Collapsed">
                            <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Model.FactorChip, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <!--
                            The qualifier can be a sentence ("FG runtime loaded (sl.dlss_g.dll) — may include generated
                            frames"); the pill trims it with an ellipsis rather than growing past its host, and the whole
                            readout's ToolTip carries the full text (2026-09-16: the Dashboard's recent-sessions row clipped it).
                        -->
                        <Border x:Name="Qualifier" Style="{StaticResource Pill}" Visibility="Collapsed">
                            <TextBlock x:Name="QualifierText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Model.QualifierText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Generated">
                            <Setter TargetName="Factor" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Presented">
                            <Setter TargetName="Qualifier" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Identified, uncounted (2026-09-14): the technology named on a warning chip, never a factor. -->
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="IdentifiedUncounted">
                            <Setter TargetName="Qualifier" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.QualifierIsWarning, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Qualifier" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="QualifierText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TriStateChip (08_UI §Tri-state feature chips): Yes filled accent · No outlined · N/A dashed, muted. -->
    <Style TargetType="{x:Type controls:TriStateChip}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <!-- beta.35 (D88): read through its peer; where a chip can be changed, the button around it is the stop. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TriStateChip}">
                    <Grid ToolTip="{Binding Model.SourceText, RelativeSource={RelativeSource TemplatedParent}}">
                        <Rectangle x:Name="Dashes" RadiusX="12" RadiusY="12" StrokeDashArray="2 2" StrokeThickness="1"
                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed" />
                        <Border x:Name="Fill" CornerRadius="12" Padding="10,3" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                            <TextBlock x:Name="Text" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Model.Text, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsYes, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsNotApplicable, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ChangeBadge (beta.30, D70): a change marker's number beside its row, in the chart badge's colours, set in code. -->
    <Style TargetType="{x:Type controls:ChangeBadge}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ChangeBadge}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,0,6,1" MinWidth="22">
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Text}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The navigation pane's item, beta.34 (owner request 2026-11-06, D86): WPF UI 4.3.0's LeftFluentNavigationViewItemTemplate
        (lepoco/wpfui, MIT - src/Wpf.Ui/Controls/NavigationView/NavigationLeftFluent.xaml at tag 4.3.0), copied with ONE
        change: its IsActive trigger animated the label's ContentGrid to height 0 and opacity 0, so the selected page lost its
        name - the owner's screenshot of Compare, and every other page the same while it was selected. The selected item keeps
        the accent bar, the selected background, the accent icon and the border animation. Set as RootNavigation.ItemTemplate
        (MainWindow.xaml): a local value outranks the default style's PaneDisplayMode=LeftFluent trigger.
    -->
    <ControlTemplate x:Key="FlLeftFluentNavigationViewItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
        <Border x:Name="MainBorder"
                MinWidth="{StaticResource PaneFluentButtonWidth}"
                Height="{StaticResource PaneFluentButtonHeight}"
                Padding="4"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Rectangle x:Name="ActiveRectangle"
                           Width="3"
                           Height="24"
                           Margin="-4,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                           Opacity="0.0"
                           RadiusX="2"
                           RadiusY="2" />
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter x:Name="IconContentPresenter"
                                      Grid.Row="0"
                                      Margin="0"
                                      Content="{TemplateBinding Icon}"
                                      TextElement.FontSize="{StaticResource NavigationViewFluentIconSize}"
                                      TextElement.Foreground="{DynamicResource NavigationViewItemForegroundLeftFluent}" />
                    <Grid x:Name="ContentGrid"
                          Grid.Row="1"
                          Height="{StaticResource NavigationViewFluentIconSize}"
                          Margin="0,2,0,0">
                        <ContentPresenter x:Name="ElementContentPresenter"
                                          HorizontalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.Foreground="{DynamicResource NavigationViewItemForegroundLeftFluent}" />
                    </Grid>
                    <ContentPresenter x:Name="PART_InfoBadge"
                                      Grid.Row="0"
                                      Margin="0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Content="{TemplateBinding InfoBadge}" />
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1.0" />
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}" />
                <Setter TargetName="IconContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                <Setter TargetName="ElementContentPresenter" Property="Margin" Value="0" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainBorder"
                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)"
                                             From="0" To="1" Duration="0:0:.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainBorder"
                                             Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)"
                                             From="1" To="0" Duration="0:0:.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconContentPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="InfoBadge" Value="{x:Null}">
                <Setter TargetName="PART_InfoBadge" Property="Margin" Value="0" />
                <Setter TargetName="PART_InfoBadge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsActive" Value="False" />
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter TargetName="IconContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}" />
                    <Setter TargetName="ContentGrid" Property="TextElement.Foreground" Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}" />
                </MultiTrigger.Setters>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
