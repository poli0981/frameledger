<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:FrameLedger.App.Controls"
                    xmlns:converters="clr-namespace:FrameLedger.App.Converters"
                    xmlns:res="clr-namespace:FrameLedger.App">
    <!--
        Our styles, merged LAST (16_WPFUI_SYNTAX §App bootstrap). Colours only through theme brushes with
        DynamicResource; the chart palette (16 §Theming) arrives with the charts (P3 PR-6) as its own dictionary.
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <converters:NotNullConverter x:Key="NotNull" />
    <converters:ZeroToVisibleConverter x:Key="ZeroToVisible" />

    <Style x:Key="PageRoot" TargetType="StackPanel">
        <Setter Property="Margin" Value="28,20,28,20" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,16,6" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- A small pill: the factor chip, the census qualifier, the tier badge. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        The Games card's hooking state (08_UI §Games). Two states, both from the theme dictionaries: ON is the accent
        pair the ×FG chip uses, OFF is the Pill's own muted fill with secondary text. It WAS `ui:Badge Appearance="Info"`
        until 2026-09-16, whose background is WPF UI's PaletteLightBlueBrush — a fixed Material colour outside the
        theme dictionaries, white-on-#03A9F4 in dark, 2.6:1 — which is the one way to break contrast that
        AccessibilityTests.NoXamlHardCodesAColour cannot see (08_UI §Contrast). ContrastTests holds both pairs now.
    -->
    <Style x:Key="HookStatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HookOn}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HookStatePillText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HookOn}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ui:InfoBar, re-templated (16_WPFUI_SYNTAX §Gotchas). WPF UI 4.3.0's own template has no ContentPresenter,
        so an InfoBar's Content (the action button 08_UI §Notifications policy puts on every persistent banner)
        was never rendered: a refusal showed as a red bar with neither the "record this session without measuring
        it" button nor (IsClosable="False" by design) a close X. This is the upstream template verbatim (MIT,
        legal/licenses/wpfui-MIT.txt) plus one column: the ContentPresenter before the close button, collapsed
        when there is no content. PagesLoadTests.TheInfoBarTemplateRendersItsContent renders both templates and
        fails the day upstream gains a ContentPresenter, so this copy is removed rather than kept out of habit.
    -->
    <Style TargetType="{x:Type ui:InfoBar}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource InfoBarTitleForeground}" />
        <Setter Property="Padding" Value="14,8,14,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:InfoBar}">
                    <Grid x:Name="InfoBarRoot">
                        <Border x:Name="ContentBorder" Padding="16,12"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding Border.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,2,14,0" VerticalAlignment="Top">
                                    <ui:SymbolIcon x:Name="SymbolIcon" VerticalAlignment="Top" Filled="True" FontSize="16" />
                                </Border>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="TitleText" Margin="0,0,14,0" ScrollViewer.CanContentScroll="False"
                                               Text="{TemplateBinding Title}" TextElement.FontSize="{TemplateBinding FontSize}"
                                               TextElement.FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Margin="0" ScrollViewer.CanContentScroll="False" Text="{TemplateBinding Message}"
                                               TextElement.FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" />
                                </WrapPanel>
                                <!-- The one addition: the InfoBar's Content, which is where the action button goes. -->
                                <ContentPresenter x:Name="ActionContent" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                <Border Grid.Column="3" Margin="12,-2,0,0" VerticalAlignment="Top">
                                    <ui:Button x:Name="CloseButton" Padding="4" Background="Transparent" BorderThickness="0" IsEnabled="True"
                                               AutomationProperties.Name="{x:Static res:Strings.Common_Close}"
                                               Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="ActionContent" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="SymbolIcon" Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarInformationalSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarSuccessSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarWarningSeverityBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                            <Setter TargetName="SymbolIcon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource InfoBarErrorSeverityBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        FpsReadout (08_UI §FPS display rule). Generated: Native primary, Displayed second, the factor as an accent
        chip. None: the number alone. Presented: the number with the census qualifier chip — muted, or a warning
        when a frame-generation runtime was loaded / the counted none was withheld.
    -->
    <Style TargetType="{x:Type controls:FpsReadout}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FpsReadout}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Model.QualifierTooltip, RelativeSource={RelativeSource TemplatedParent}}">
                        <ui:TextBlock FontTypography="Subtitle" VerticalAlignment="Center" Text="{Binding Model.Line, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Factor" Style="{StaticResource Pill}" Background="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0"
                                Visibility="Collapsed">
                            <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding Model.FactorChip, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <!--
                            The qualifier can be a sentence ("FG runtime loaded (sl.dlss_g.dll) — may include generated
                            frames"); the pill trims it with an ellipsis rather than growing past its host, and the whole
                            readout's ToolTip carries the full text (2026-09-16: the Dashboard's recent-sessions row clipped it).
                        -->
                        <Border x:Name="Qualifier" Style="{StaticResource Pill}" Visibility="Collapsed">
                            <TextBlock x:Name="QualifierText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Model.QualifierText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Generated">
                            <Setter TargetName="Factor" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="Presented">
                            <Setter TargetName="Qualifier" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Identified, uncounted (2026-09-14): the technology named on a warning chip, never a factor. -->
                        <DataTrigger Binding="{Binding Model.Kind, RelativeSource={RelativeSource Self}}" Value="IdentifiedUncounted">
                            <Setter TargetName="Qualifier" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.QualifierIsWarning, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Qualifier" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="QualifierText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TriStateChip (08_UI §Tri-state feature chips): Yes filled accent · No outlined · N/A dashed, muted. -->
    <Style TargetType="{x:Type controls:TriStateChip}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TriStateChip}">
                    <Grid ToolTip="{Binding Model.SourceText, RelativeSource={RelativeSource TemplatedParent}}">
                        <Rectangle x:Name="Dashes" RadiusX="12" RadiusY="12" StrokeDashArray="2 2" StrokeThickness="1"
                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed" />
                        <Border x:Name="Fill" CornerRadius="12" Padding="10,3" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent">
                            <TextBlock x:Name="Text" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Model.Text, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsYes, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsNotApplicable, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Fill" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
