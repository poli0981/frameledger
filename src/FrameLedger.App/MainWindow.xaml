<ui:FluentWindow x:Class="FrameLedger.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:FrameLedger.App.Pages"
                 xmlns:res="clr-namespace:FrameLedger.App"
                 Title="{x:Static res:Strings.App_Title}"
                 Width="1180"
                 Height="760"
                 MinWidth="800"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!--
        docs/16_WPFUI_SYNTAX.md §Main window skeleton: TitleBar row, a classic Menu row BELOW it (never inside the
        drag region), then the NavigationView. Every string is a resx key; every colour a theme brush.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.App_Title}">
            <ui:TitleBar.TrailingContent>
                <ui:Badge Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          Appearance="{Binding ViewModel.AgentStatusAppearance}"
                          Content="{Binding ViewModel.AgentStatusText}" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Menu Grid.Row="1">
            <MenuItem Header="{x:Static res:Strings.Menu_File}">
                <MenuItem Header="{x:Static res:Strings.Menu_File_AddGame}" Command="{Binding ViewModel.AddGameCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_File_ImportLibrary}" Command="{Binding ViewModel.ImportLibraryCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_File_Export}">
                    <MenuItem Header="{x:Static res:Strings.Menu_File_Export_Csv}" Command="{Binding ViewModel.ExportCsvCommand}" />
                    <MenuItem Header="{x:Static res:Strings.Menu_File_Export_Json}" Command="{Binding ViewModel.ExportJsonCommand}" />
                    <MenuItem Header="{x:Static res:Strings.Menu_File_Export_Png}" Command="{Binding ViewModel.ExportPngCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Menu_File_Exit}" Command="{Binding ViewModel.ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Menu_Tools}">
                <MenuItem Header="{x:Static res:Strings.Menu_Tools_AgentStatus}" Command="{Binding ViewModel.AgentStatusCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Tools_UpdateRules}" Command="{Binding ViewModel.UpdateRulesCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Tools_VulkanLayer}" Command="{Binding ViewModel.VulkanLayerCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Tools_OpenDataFolder}" Command="{Binding ViewModel.OpenDataFolderCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Tools_DbMaintenance}" Command="{Binding ViewModel.DatabaseMaintenanceCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Menu_Help}">
                <MenuItem Header="{x:Static res:Strings.Menu_Help_CheckUpdates}" Command="{Binding ViewModel.CheckForUpdatesCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Help_ReportBug}" Command="{Binding ViewModel.ReportBugCommand}" />
                <MenuItem Header="{x:Static res:Strings.Menu_Help_Documentation}" Command="{Binding ViewModel.DocumentationCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Menu_Help_About}" Command="{Binding ViewModel.AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- 08_UI §Notifications policy: "Agent offline" is in-app and PERSISTENT — an InfoBar with an action, never a toast. -->
        <StackPanel Grid.Row="2">
            <ui:InfoBar Margin="12,4,12,0"
                        IsClosable="False"
                        IsOpen="{Binding ViewModel.IsAgentBannerVisible}"
                        Message="{Binding ViewModel.AgentBannerBody}"
                        Severity="Warning"
                        Title="{x:Static res:Strings.Agent_Banner_Offline_Title}">
                <ui:Button Appearance="Secondary"
                           Command="{Binding ViewModel.RetryAgentCommand}"
                           Content="{x:Static res:Strings.Agent_Banner_Retry}" />
            </ui:InfoBar>

            <!--
                11_UPDATER (P4 PR-5): "update downloaded" is in-app and PERSISTENT, with the one action. The button is
                disabled, not hidden, while a session runs (FR-12) — the body says the update waits for the session's end.
            -->
            <ui:InfoBar Margin="12,4,12,0"
                        IsClosable="False"
                        IsOpen="{Binding ViewModel.IsUpdateBannerVisible}"
                        Message="{Binding ViewModel.UpdateBannerBody}"
                        Severity="Informational"
                        Title="{x:Static res:Strings.Update_Banner_Title}">
                <ui:Button Appearance="Primary"
                           Command="{Binding ViewModel.RestartToUpdateCommand}"
                           Content="{x:Static res:Strings.Update_Banner_Restart}"
                           IsEnabled="{Binding ViewModel.CanRestartToUpdate}" />
            </ui:InfoBar>

            <!--
                The safety events (CaptureRefused, SafetyUnhook, CaptureDegraded): persistent, the signal named, never
                dismissed by a timeout — the one button is the user's acknowledgement (08_UI §Notifications policy, FR-14).
            -->
            <ItemsControl ItemsSource="{Binding ViewModel.Notices.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar Margin="12,4,12,0"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding Body}"
                                    Severity="{Binding Severity}"
                                    Title="{Binding Title}">
                            <ui:Button Appearance="Secondary"
                                       Command="{Binding DataContext.ViewModel.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Content="{Binding ActionText}" />
                        </ui:InfoBar>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="3"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           PaneDisplayMode="LeftFluent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Dashboard}"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Games}"
                                       Icon="{ui:SymbolIcon Games24}"
                                       TargetPageType="{x:Type pages:GamesPage}" />
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Compare}"
                                       Icon="{ui:SymbolIcon ArrowSwap24}"
                                       TargetPageType="{x:Type pages:ComparePage}" />
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Logs}"
                                       Icon="{ui:SymbolIcon DocumentText24}"
                                       TargetPageType="{x:Type pages:LogsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="3" VerticalAlignment="Bottom" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="3" />
    </Grid>
</ui:FluentWindow>
