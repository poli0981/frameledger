<Application x:Class="FrameLedger.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        docs/16_WPFUI_SYNTAX.md §App bootstrap: dictionaries IN THIS ORDER (Themes before Controls, our styles
        last) or every control renders default-looking with no error. No StartupUri: the Generic Host in
        App.xaml.cs owns the window. ShutdownMode is explicit: the host's lifetime ends the process (the shell
        host stops it when the live window closes), so a language rebuild closing the old window is not an exit.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/FrameLedger.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
