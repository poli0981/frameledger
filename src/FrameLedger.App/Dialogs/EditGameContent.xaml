<UserControl x:Class="FrameLedger.App.Dialogs.EditGameContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:EditGameViewModel}"
             mc:Ignorable="d"
             MinWidth="420">
    <!--
        FR-1.3: a detected field is badged (05_DETECTION §Caching), and saving marks what changed as the user's.
        A TagPill, not ui:Badge: Info's background is a fixed Material colour outside the theme dictionaries, and Secondary keeps the
        default badge's on-accent foreground over a near-white fill in the light theme (08_UI §Contrast, 2026-09-21).
    -->
    <StackPanel>
        <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource TagPill}"
                    Visibility="{Binding NameDetected, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource TagPillText}" Text="{x:Static vm:EditGameViewModel.DetectedBadge}" />
            </Border>
            <ui:TextBlock Appearance="Secondary" Text="{x:Static vm:EditGameViewModel.NameLabel}" />
        </DockPanel>
        <ui:TextBox Margin="0,4,0,12" AutomationProperties.Name="{x:Static vm:EditGameViewModel.NameLabel}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource TagPill}"
                    Visibility="{Binding PublisherDetected, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource TagPillText}" Text="{x:Static vm:EditGameViewModel.DetectedBadge}" />
            </Border>
            <ui:TextBlock Appearance="Secondary" Text="{x:Static vm:EditGameViewModel.PublisherLabel}" />
        </DockPanel>
        <ui:TextBox Margin="0,4,0,12" AutomationProperties.Name="{x:Static vm:EditGameViewModel.PublisherLabel}" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" />

        <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource TagPill}"
                    Visibility="{Binding VersionDetected, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource TagPillText}" Text="{x:Static vm:EditGameViewModel.DetectedBadge}" />
            </Border>
            <ui:TextBlock Appearance="Secondary" Text="{x:Static vm:EditGameViewModel.VersionLabel}" />
        </DockPanel>
        <ui:TextBox Margin="0,4,0,12" AutomationProperties.Name="{x:Static vm:EditGameViewModel.VersionLabel}" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />

        <ui:TextBlock Appearance="Secondary" Text="{x:Static vm:EditGameViewModel.NotesLabel}" />
        <ui:TextBox Margin="0,4,0,0" MinHeight="72" AutomationProperties.Name="{x:Static vm:EditGameViewModel.NotesLabel}" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
