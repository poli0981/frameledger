<UserControl x:Class="FrameLedger.App.Dialogs.GuardBypassDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:GuardBypassDialogViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MaxWidth="660">
    <!--
        The guard-bypass disclosure (owner decision 2026-09-21, 19_SAFETY §The user's bypass). Text from
        FrameLedger.Shared's Safety_Bypass_* only. Order: what the switch is, what the guard found, what can happen, who
        carries it, what is recorded, then the two acts. The risk and the liability paragraphs sit on the theme's
        critical fill with primary text (a pair ContrastTests measures); every colour is a theme brush (16_WPFUI §Theming).
    -->
    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ui:TextBlock Text="{x:Static vm:GuardBypassDialogViewModel.Intro}" TextWrapping="Wrap" />

            <ui:TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding Found}" TextWrapping="Wrap" />

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static vm:GuardBypassDialogViewModel.Risk}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <ui:TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{x:Static vm:GuardBypassDialogViewModel.Liability}" TextWrapping="Wrap" />
            </Border>

            <ui:TextBlock Margin="0,12,0,0" Text="{x:Static vm:GuardBypassDialogViewModel.Recorded}" TextWrapping="Wrap" />

            <CheckBox Margin="0,16,0,0" IsChecked="{Binding Acknowledged, Mode=TwoWay}"
                      AutomationProperties.Name="{x:Static vm:GuardBypassDialogViewModel.CheckboxText}">
                <TextBlock Text="{x:Static vm:GuardBypassDialogViewModel.CheckboxText}" TextWrapping="Wrap" MaxWidth="600" />
            </CheckBox>

            <ui:TextBlock Margin="0,14,0,6" Appearance="Secondary" Text="{Binding TypeToConfirm}" TextWrapping="Wrap" />
            <ui:TextBox AutomationProperties.Name="{Binding TypeToConfirm}"
                        Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static vm:GuardBypassDialogViewModel.Phrase}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
