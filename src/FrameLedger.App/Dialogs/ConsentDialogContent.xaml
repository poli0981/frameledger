<UserControl x:Class="FrameLedger.App.Dialogs.ConsentDialogContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FrameLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConsentDialogViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MaxWidth="640">
    <!--
        FR-2.1 (19_SAFETY §User-facing consent), text from FrameLedger.Shared's Safety_Consent_* only. The two
        tiers are two paragraphs of the same shape, in the order enable / do-not-enable, with nothing between
        them that reads as a recommendation. Every colour is a theme brush (16_WPFUI §Theming).
    -->
    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ui:TextBlock Text="{x:Static vm:ConsentDialogViewModel.Intro}" TextWrapping="Wrap" />

            <ui:TextBlock Margin="0,14,0,0" Text="{x:Static vm:ConsentDialogViewModel.Injected}" TextWrapping="Wrap" />

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ui:TextBlock Text="{x:Static vm:ConsentDialogViewModel.Hooked}" TextWrapping="Wrap" />
            </Border>
            <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ui:TextBlock Text="{x:Static vm:ConsentDialogViewModel.NotHooked}" TextWrapping="Wrap" />
            </Border>

            <ui:TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="{x:Static vm:ConsentDialogViewModel.AntiCheat}" TextWrapping="Wrap" />
            <ui:TextBlock Margin="0,8,0,0" Text="{x:Static vm:ConsentDialogViewModel.Terms}" TextWrapping="Wrap" />

            <ui:TextBlock Margin="0,18,0,6" Appearance="Secondary" Text="{Binding TypeToConfirm}" TextWrapping="Wrap" />
            <ui:TextBox x:Name="Acknowledgement"
                        AutomationProperties.Name="{Binding TypeToConfirm}"
                        Text="{Binding Typed, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{x:Static vm:ConsentDialogViewModel.Phrase}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
