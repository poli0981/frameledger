<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite, shm reader, vendor telemetry, injector interop, ETW fallback,
    parsers. Implements the ports declared in FrameLedger.Application.

    CLAUDE.md: "The native layer is reachable only through Infrastructure —
    no P/Invoke anywhere else." This project is the only one that may carry
    CsWin32 or DllImport declarations.
  -->

  <!--
    CsWin32 with marshaling off (NativeMethods.json) generates raw vtable structs for the DXGI
    interfaces Telemetry/DxgiAdapters.cs walks; that is pointer code by construction.
    Nothing else in this assembly is unsafe, and nothing in the tree outside it may be.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <!--
    The guard DLL is deliberately NOT copied from here any more (§S18 blocker 3,
    ratified 2026-08-04). A `None` item in this file flows to every project that
    references Infrastructure, which is how FrameLedger.exe came to host the
    anti-cheat guard as a side effect of wanting SQLite and detection — and why
    §S18 could not identify "our own process" by pid.

    The copy now lives in /FrameLedger.Guard.targets, imported only by the Agent
    (the host) and by Infrastructure.Tests (which P/Invokes the real DLL). This
    assembly still CALLS the guard through NativeAntiCheatGuard; it just no
    longer decides who ships it.
  -->

  <!--
    The migration scripts ship INSIDE the assembly (06_DATA_MODEL §Migrations: "sequential embedded
    SQL"), so the schema a build applies is the schema that build was tested against, and a file
    beside the binary cannot be edited into something else. MigrationRunner enumerates them by name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" LogicalName="FrameLedger.Infrastructure.Persistence.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    SonarCloud's CI analysis (docs/13_CI_CD.md §SonarCloud, D68). The SonarScanner for .NET analyses only the files an
    MSBuild project names, and the native code is CMake's - so this project, the one that reaches the native layer,
    names it. FlNativeSource is an item type MSBuild does nothing with; the scanner's targets read it through
    SQAdditionalAnalysisFileItemTypes, and because the files lie outside this folder it analyses them at the root, with
    the compilation database SonarQube.Analysis.xml names. The items exist only in a build the scanner instruments
    (its ImportBefore targets set SonarQubeTempPath; items are evaluated after every property, so the condition sees
    it), so an ordinary build, an IDE and a publish never see them. The property cannot wait for it: the scanner's
    targets read it while properties are still being evaluated, after this file's body, and nothing else reads it.
  -->
  <PropertyGroup>
    <SQAdditionalAnalysisFileItemTypes>FlNativeSource</SQAdditionalAnalysisFileItemTypes>
  </PropertyGroup>
  <ItemGroup Condition="'$(SonarQubeTempPath)' != ''">
    <FlNativeSource Include="..\native\**\*.cpp;..\native\**\*.h" Exclude="..\native\third_party\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
