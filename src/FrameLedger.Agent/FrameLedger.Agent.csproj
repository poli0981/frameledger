<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capture orchestrator: process watcher, anti-cheat guard, injector control,
    shm drain, telemetry poller, session recorder (docs/04_CAPTURE.md).
    Runs as a standard user by default (ADR-9); elevation is optional and only
    unlocks CPU sensors and elevated-game attach. No capture tier needs it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>FrameLedger.Agent</AssemblyName>
    <RootNamespace>FrameLedger.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Infrastructure\FrameLedger.Infrastructure.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The command-line surface and the composition are internal; the test project pins both. -->
    <InternalsVisibleTo Include="FrameLedger.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    The Agent is the SOLE host of the anti-cheat guard (§S18 blocker 3, ratified
    2026-08-04; 05_DETECTION §Trust and staleness and 07_IPC already assigned it
    ownership of %LOCALAPPDATA%\FrameLedger). FrameLedger.App deliberately does
    not import this.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Guard.targets" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.NvapiBridge.targets" />

  <!-- The seed the Agent installs to the product location on first run (§S20). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Rules.targets" />

  <!--
    The payload, which must land in the SAME directory as the guard: §S22 makes
    the guard refuse a DLL that does not resolve there. Nothing shipped the
    Overlay anywhere before this import existed.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Overlay.targets" />

  <!--
    The Vulkan implicit layer beside the Agent (P1 item 3, P2 PR-F). the console `launch` verb writes a manifest
    pointing at THIS copy and hands the launched process VK_ADD_IMPLICIT_LAYER_PATH, so the layer is
    discoverable only by that process: no registry, nothing machine-wide (VkLayerLaunchEnvironment).
    Warn-not-fail like the others: build.ps1 runs the native build first, and a missing DLL is reported by
    `launch` itself. The kill switch (FR-2.4) is honoured by NOT setting the enable variable (decision D7).
  -->
  <PropertyGroup>
    <FlVkLayerDir>$(MSBuildThisFileDirectory)..\..\build\native\x64-release\FrameLedger.VkLayer\</FlVkLayerDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(FlVkLayerDir)FrameLedger.VkLayer.dll" Condition="Exists('$(FlVkLayerDir)FrameLedger.VkLayer.dll')">
      <Link>FrameLedger.VkLayer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
