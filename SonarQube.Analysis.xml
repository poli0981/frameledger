<?xml version="1.0" encoding="utf-8"?>
<!--
  SonarCloud, analysed from CI since 2026-10-25 (docs/13_CI_CD.md §SonarCloud, owner decision D68): ci.yml's
  `sonarcloud` job passes this file to the SonarScanner for .NET's begin step (/s:). It replaces
  .sonarcloud.properties, which only Automatic Analysis read (D67). The project key, the organisation, the version
  and the token are given on the command line; everything that does not change from one run to the next is here.
-->
<SonarQubeAnalysisProperties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">

  <Property Name="sonar.host.url">https://sonarcloud.io</Property>

  <!--
    What is not FrameLedger's code, or not code at all:
    - src/native/third_party: the vendored SDK headers (NVAPI, Streamline, FidelityFX, Vulkan-Headers), consumed
      unmodified (each folder's README says so and license-check holds it).
    - Strings.Designer.cs: generated by tools/resx-gen.ps1.
    - dxr_raygen_dxil.h: a compiled shader as a byte array, generated.
    - vendor-stubs: test fixtures that carry the vendors' export names and signatures on purpose.
    - tests/fixtures: the detection corpus (empty marker binaries and expected JSON).
    - legal/licenses, docs/vendor-exports.json: licence texts and a generated export list.
    - Migrations: SQLite scripts, which a SQL analyser reads as another dialect.
    And, since the scanner reads the whole checkout for the languages it finds outside the projects (PowerShell,
    YAML, JSON), what a build writes into it: the native build tree with the sources CMake fetched into it, out/,
    every project's bin/ and obj/, and the test results the coverage comes from.
  -->
  <Property Name="sonar.exclusions">src/native/third_party/**,**/Strings.Designer.cs,src/native/tools/hook-harness/dxr_raygen_dxil.h,src/native/tools/vendor-stubs/**,tests/fixtures/**,legal/licenses/**,docs/vendor-exports.json,src/FrameLedger.Infrastructure/Persistence/Migrations/**,build/**,out/**,**/bin/**,**/obj/**,**/TestResults/**</Property>

  <!-- Tests repeat their arrange steps on purpose; duplication there is not a defect. -->
  <Property Name="sonar.cpd.exclusions">tests/**,src/native/tests/**</Property>

  <Property Name="sonar.sourceEncoding">UTF-8</Property>

  <!--
    The native code: CMake's compilation database for the x64-release preset, which the job configures before the
    begin step. The sources reach the analysis through FrameLedger.Infrastructure.csproj's FlNativeSource items,
    because the scanner analyses only files an MSBuild project names. Reported against C++20, the standard
    src/native/CMakeLists.txt sets.
  -->
  <Property Name="sonar.cfamily.compile-commands">build/native/x64-release/compile_commands.json</Property>
  <Property Name="sonar.cfamily.reportingCppStandardOverride">c++20</Property>

  <!--
    The gate's coverage: build.ps1 writes OpenCover beside the Cobertura that tools/coverage-gate.ps1 reads, one
    report per test project in TestResults/<guid>/. The second copy the trx logger keeps under In/ is not matched.
  -->
  <Property Name="sonar.cs.opencover.reportsPaths">tests/*/TestResults/*/coverage.opencover.xml</Property>

  <!--
    Coverage is measured for the C# only. SonarCloud counts the executable lines of a file no report covers as
    uncovered - the first analysis read build.ps1's 232 lines to cover, every one uncovered, and failed the gate on the
    two a pull request changed - so the PowerShell tools (tested by their own -SelfTest cases, which no coverage tool
    reads) and the native code (Catch2 suites and the injection tests, with no coverage collector) are left out of the
    coverage figures. They are analysed for issues as everything else is.
  -->
  <Property Name="sonar.coverage.exclusions">**/*.ps1,**/*.psm1,src/native/**</Property>

  <!--
    Roslynator, Meziantou, the VS threading analyzers and the .NET analyzers already gate the build (warnings as
    errors); what they report at a lower severity is the project's choice. Only SonarCloud's own rules are imported.
  -->
  <Property Name="sonar.cs.roslyn.ignoreIssues">true</Property>

  <!--
    Two rules this project breaks by design everywhere they apply (the triage of 2026-10-19 in docs/13_CI_CD.md
    accepted every instance):
    - S8417, sequentially consistent atomics: the SPSC ring and the hook counters use explicit acquire/release and
      relaxed orders on purpose (07_IPC); sequential consistency would add fences on the per-present path. The rule
      key's repository is a wildcard because a header is indexed as C and a source file as C++.
    - csharpsquid:S6640, unsafe code: interop with the native layer and the shared-memory mirror, confined to
      Infrastructure and Shared (CLAUDE.md: the native layer is reachable only through Infrastructure).
  -->
  <Property Name="sonar.issue.ignore.multicriteria">atomics,unsafeInfrastructure,unsafeShared</Property>
  <Property Name="sonar.issue.ignore.multicriteria.atomics.ruleKey">*:S8417</Property>
  <Property Name="sonar.issue.ignore.multicriteria.atomics.resourceKey">src/native/**/*</Property>
  <Property Name="sonar.issue.ignore.multicriteria.unsafeInfrastructure.ruleKey">csharpsquid:S6640</Property>
  <Property Name="sonar.issue.ignore.multicriteria.unsafeInfrastructure.resourceKey">src/FrameLedger.Infrastructure/**/*</Property>
  <Property Name="sonar.issue.ignore.multicriteria.unsafeShared.ruleKey">csharpsquid:S6640</Property>
  <Property Name="sonar.issue.ignore.multicriteria.unsafeShared.resourceKey">src/FrameLedger.Shared/**/*</Property>

  <!-- The end step waits for the quality gate, so a failed gate is a red job, not a check nobody opens. -->
  <Property Name="sonar.qualitygate.wait">true</Property>
  <Property Name="sonar.qualitygate.timeout">600</Property>

</SonarQubeAnalysisProperties>
